from os import PathLike

FFMPEG_FILTER: str

class UnsupportedError(ValueError):
    """The file cannot be stitched; retrying won't help."""

class Insta360File:
    """An Insta360 .insp or .insv file, opened by reading its trailer."""

    def __init__(self, path: str | PathLike[str]) -> None: ...
    @property
    def stitchable(self) -> bool: ...
    @property
    def unsupported_reason(self) -> str | None: ...
    @property
    def local_time(self) -> str | None: ...
    @property
    def offset_state(self) -> int: ...
    @property
    def preview_size(self) -> tuple[int, int] | None: ...
    def preview(self) -> tuple[int, int, bytes]: ...
    def stitch_photo(self, raw: bytes, width: int, height: int, channels: int = 3) -> bytes: ...
    def video_maps(self, width: int, lens_height: int) -> dict[str, int | bytes]: ...

def camera_utc_offset_minutes(local_time: str, utc_unix_seconds: int) -> int | None: ...
